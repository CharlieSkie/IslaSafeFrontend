# Frontend application settings
VITE_APP_NAME=IslaSafe Admin
VITE_APP_ENV=development

# Backend API integration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT_MS=15000

# MapLibre configuration
VITE_MAP_PROVIDER=maplibre
VITE_MAP_TILE_PROVIDER=esri
# Add a browser-restricted key only when the configured map provider requires one.
VITE_MAP_API_KEY=

# Satellite imagery
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Street map
VITE_MAP_STREETS_TILE_URL=
VITE_MAP_STREETS_ATTRIBUTION=
VITE_MAP_MAX_ZOOM=

# Local development behavior
VITE_ENABLE_MOCK_DATA=true
