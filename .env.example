# Frontend application settings
VITE_APP_NAME=IslaSafe Admin
VITE_APP_ENV=development

# Backend API integration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT_MS=15000

# Map integration
# Add a browser-restricted map key here only when a map provider requires one.
VITE_MAP_PROVIDER=
VITE_MAP_API_KEY=
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_MAP_STREETS_TILE_URL=
VITE_MAP_STREETS_ATTRIBUTION=
VITE_MAP_MAX_ZOOM=

# Local development behavior
VITE_ENABLE_MOCK_DATA=true
